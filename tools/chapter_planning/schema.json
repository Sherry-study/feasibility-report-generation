{
  "tool": "chapter_planning",
  "contract_version": "1.0",
  "stage": "3_chapter_planning",
  "input": {
    "facts": "confirmed_project_facts.json (required)",
    "profile": "file (required)",
    "output_dir": "dir (required)",
    "research_evidence": "file",
    "section_drafts": "file",
    "ai_mode": "host_agent|disabled (default host_agent)",
    "run_mode": "production|test (default production, test requires FEASIBILITY_SKILL_DEV_TEST=1)",
    "skip_user_inputs": "bool (skip deferred_questions gate, keep gaps)"
  },
  "output": {
    "chapter_plan": "chapter_plan.json (generated here from profile, after confirmation gate)",
    "gap_analysis": "gap_analysis.json",
    "research_tasks": "research_tasks.json",
    "research_fragments": "research_fragments/ (worker_contexts + HOST_WORKFLOW only)",
    "research_validation": "research_validation.json",
    "llm_jobs": "llm_jobs.json (compact validation contract)",
    "draft_fragments": "draft_fragments/ (worker_contexts + HOST_WORKFLOW only)",
    "section_drafts_validation": "section_drafts_validation.json"
  },
  "exit_codes": {
    "0": "planning_ready",
    "9": "needs_user_input (deferred_questions: compilation info asked once after confirmation gate)",
    "10": "needs_research",
    "11": "needs_llm (use draft_fragments/HOST_WORKFLOW.md worker packs)"
  }
}
