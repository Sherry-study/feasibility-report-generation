{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feasibility Section Drafts",
  "type": "object",
  "required": [
    "contract_version",
    "project_id",
    "drafts"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string"
    },
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "draft_status",
          "subsections",
          "source_evidence_ids"
        ],
        "properties": {
          "section_id": {
            "type": "string"
          },
          "draft_status": {
            "enum": [
              "draft",
              "partial",
              "blocked",
              "not_applicable"
            ]
          },
          "subsections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "heading",
                "paragraphs"
              ],
              "properties": {
                "heading": {
                  "type": "string"
                },
                "paragraphs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "source_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "evidence_ids"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "evidence_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "open_items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
