{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feasibility Report Confirmation Response",
  "type": "object",
  "required": ["contract_version", "project_id", "decision"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "project_id": {"type": ["string", "null"]},
    "decision": {"const": "confirmed"},
    "confirmed_by": {"type": "string"},
    "note": {"type": ["string", "null"]},
    "changes": {
      "type": "object",
      "properties": {
        "recommended_scheme": {"type": "object"},
        "economic_summary": {"type": "object"},
        "equipment_summary": {"type": "array"},
        "retrofit_points": {"type": "array"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
