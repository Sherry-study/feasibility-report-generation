{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feasibility Report Project Profile",
  "type": "object",
  "required": ["project_id", "project_name", "project_level", "project_type", "changes"],
  "properties": {
    "project_id": {"type": "string"},
    "project_name": {"type": "string"},
    "project_level": {"enum": ["equipment", "unit", "system", "plant"]},
    "project_type": {"type": "string"},
    "retrofit_scope": {"type": ["string", "null"]},
    "objectives": {"type": "array", "items": {"type": "string"}},
    "energy_accounting_standard": {"enum": ["standard_coal", "standard_oil"], "description": "能耗折标口径：默认 standard_coal（GB/T 2589）；standard_oil（GB/T 50441）仅在显式口径要求时使用"},
    "changes": {"type": "object", "additionalProperties": {"type": ["boolean", "null", "string", "number", "array", "object"]}}
  },
  "additionalProperties": true
}
