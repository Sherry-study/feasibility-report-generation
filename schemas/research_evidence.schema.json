{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feasibility Research Evidence",
  "type": "object",
  "required": [
    "contract_version",
    "project_id",
    "items"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string"
    },
    "generated_by": {
      "type": "string"
    },
    "test_only": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "task_id",
          "claim",
          "source_title",
          "publisher",
          "source_url",
          "source_type",
          "content_summary"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source_title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "accessed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_type": {
            "type": "string"
          },
          "official_source": {
            "type": "boolean"
          },
          "source_authority": {
            "type": [
              "string",
              "null"
            ]
          },
          "reliability": {
            "type": [
              "string",
              "null"
            ]
          },
          "geography": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_period": {
            "type": [
              "string",
              "null"
            ]
          },
          "effective_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "standard_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_summary": {
            "type": "string"
          },
          "numeric_facts": {
            "type": "array"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}